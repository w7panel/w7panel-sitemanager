{
  "php_perpetual_extensions": "",
  "template": {
    "description": "$extension_name",
    "install_command": "log_file=/tmp/install-php-extensions.log; : >\"$log_file\"; { if [ ! -x /usr/local/bin/install-php-extensions ]; then curl -fsSL \"https://ghfast.top/https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions\" -o /usr/local/bin/install-php-extensions && chmod +x /usr/local/bin/install-php-extensions; fi && install-php-extensions $extension_name; } >>\"$log_file\" 2>&1 ; rm -f \"$log_file\" ; kill -USR2 1",
    "uninstall_command": "rm -f \"$(php-config --extension-dir)/$extension_name.so\" && rm /usr/local/etc/php/conf.d/docker-php-ext-$extension_name.ini && kill -USR2 1",
    "enable_command": "ini_file=\"/usr/local/etc/php/conf.d/docker-php-ext-$extension_name.ini\" && { [ ! -f \"$ini_file\" ] && { [ \"$extension_name\" = \"opcache\" ] || [ \"$extension_name\" = \"xdebug\" ] || [ \"$extension_name\" = \"ioncube_loader\" ] && echo \"zend_extension=$extension_name.so\" > \"$ini_file\" || echo \"extension=$extension_name.so\" > \"$ini_file\"; }; } ; sed -i 's/^;\\(.*extension.*$extension_name.*\\)/\\1/' \"$ini_file\" && kill -USR2 1",
    "disable_command": "sed -i 's/^\\(.*extension.*$extension_name.*\\)/;\\1/' /usr/local/etc/php/conf.d/docker-php-ext-$extension_name.ini  && kill -USR2 1",
    "not_support_php_versions": []
  },
